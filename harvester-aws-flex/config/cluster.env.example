# harvester-aws-flex cluster configuration
# Copy to a working directory as cluster.env, edit, then run the scripts from
# that directory (or point HAF_CONFIG at this file). State is written to
# ./state-<CLUSTER_NAME>/ next to this file.

# ---------------------------------------------------------------- AWS
AWS_REGION=us-east-2
AZ=us-east-2a
# Leave blank to use the default subnet of $AZ (and its VPC).
SUBNET_ID=
# Existing EC2 key pair, and the matching private key on this machine.
KEY_NAME=my-key-pair
SSH_KEY_FILE=~/.ssh/my-key-pair.pem
# CIDR allowed to reach the UI (443), SSH (22) and the K8s API (6443).
# Leave blank to auto-detect your current public IP as /32.
ADMIN_CIDR=

# ------------------------------------------------------------ Cluster
CLUSTER_NAME=harvester-flex
NODE_PREFIX=harvester-flex-node
# Must support both UEFI and nested-virtualization, with >= 8 vCPU / 32 GiB.
# m8i-flex.2xlarge (8 vCPU / 32 GiB) is the cheapest type that meets
# Harvester's minimum. Bare-metal x86 types are legacy-BIOS only and will
# NOT work with Harvester >= v1.8.
INSTANCE_TYPE=m8i-flex.2xlarge
# Pick a version supported by your Rancher (see the SUSE support matrix):
# Rancher 2.14 -> Harvester v1.8.x, Rancher 2.15 -> v1.9.x.
HARVESTER_VERSION=v1.8.2
# Static private IPs inside SUBNET_ID's CIDR. The VIP is attached to node 1
# as a secondary IP. All four must be unused.
VIP=172.31.12.10
NODE_IPS="172.31.12.11 172.31.12.12 172.31.12.13"
# One EBS gp3 volume per node: OS (~173 GB) + Longhorn data partition (rest).
ROOT_VOLUME_GB=350
ROOT_VOLUME_IOPS=6000
ROOT_VOLUME_THROUGHPUT=250

# Reuse an existing UEFI iPXE AMI (built by 02-build-ipxe-ami.sh).
# Leave blank to build one in this account.
IPXE_AMI_ID=
IPXE_EFI_URL=https://boot.ipxe.org/x86_64-efi/ipxe.efi

# After install, switch nodes to IMDSv2-only (iPXE needs IMDSv1 only while
# installing). Set to false if you plan to re-install the nodes.
IMDS_REQUIRE_TOKENS_AFTER_INSTALL=true

# ---------------------------------------------------- Rancher (optional)
RANCHER_IMPORT=true
# kubectl context that points at the Rancher *local* cluster.
# Blank = current kubectl context.
RANCHER_KUBECONTEXT=
